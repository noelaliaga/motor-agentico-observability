# Names only. Copy to your shell profile or a launchd plist; never commit values.
# Every variable is optional: without them the reader looks under $HOME and
# writes to ./data/motor.sqlite.

# Where the index lives (the web reads the same file, read-only)
MOTOR_BASE=
# Root used to resolve every source below (default: $HOME)
MOTOR_CASA=
# Individual sources (defaults: under MOTOR_CASA)
MOTOR_CLAUDE=
MOTOR_CLAUDE_JSON=
MOTOR_CODEX=
MOTOR_HERMES=
MOTOR_OPENCLAW=
MOTOR_LAUNCHAGENTS=
# Optional sources (off when empty)
MOTOR_NOTAS=
MOTOR_MULTIVERSO=
# Extra project .mcp.json files, separated by ':'
MOTOR_MCP_JSON=
# Name the nightly review uses in its prompts (and the web header)
MOTOR_USUARIO=
# 1 = let the review send conversation excerpts to the LLM (default: off)
MOTOR_SUENO_LEE=
# 0 = do not run `launchctl list` / `hermes cron list`
MOTOR_CRON_COMANDOS=
# Paths to CLIs if they are not on PATH
MOTOR_CLAUDE_CLI=
MOTOR_HERMES_CLI=
# OpenRouter: the only source that calls the network, and only with a key
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
