<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE. Replace __REPO__ with the absolute path of this repository,
  __HOME__ with your home directory and __PYTHON__ with the absolute path of a
  Python 3.11+ interpreter (not /usr/bin/python3, which is 3.9 on macOS), save it as
  ~/Library/LaunchAgents/com.example.motor.reader.plist and load it with
  `launchctl load ~/Library/LaunchAgents/com.example.motor.reader.plist`.

  The reader in a loop, restarted if it dies. It only writes to MOTOR_DB.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.motor.reader</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/reader/reader.py</string>
    <string>--loop</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>MOTOR_DB</key>
    <string>__REPO__/data/motor.sqlite</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO__/data/reader.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/reader.log</string>
</dict>
</plist>
