<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE. Replace __REPO__ and __HOME__ as in the reader template.

  The nightly review at 07:00. As written it calls `claude -p` with every
  tool disabled, which SENDS the computed facts to Anthropic. Add `--seco`
  to the arguments to keep it fully local (findings printed, nothing sent).
  MOTOR_SUENO_LEE is deliberately absent: conversation reading stays off.
  launchd starts jobs with a minimal PATH, so point MOTOR_CLAUDE_CLI at the
  absolute path of the `claude` binary.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.motor.sueno</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/lector/sonar.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>MOTOR_BASE</key>
    <string>__REPO__/data/motor.sqlite</string>
    <key>MOTOR_CLAUDE_CLI</key>
    <string>__HOME__/.local/bin/claude</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/data/sueno.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/sueno.log</string>
</dict>
</plist>
